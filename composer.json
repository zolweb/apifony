{
    "name": "zolteam/apifony",
    "license": "AGPL-3.0-or-later",
    "bin": [
        "apifony"
    ],
    "require": {
        "php": ">=8.2",
        "nikic/php-parser": "^4.16 || ^5.0",
        "phpstan/phpdoc-parser": "^1.21 || ^2.0",
        "symfony/string": "^6.4 || ^7.0 || ^8.0",
        "symfony/uid": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "egulias/email-validator": "^2.1.10 || ^3 || ^4",
        "friendsofphp/php-cs-fixer": "3.95.11",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.2.5",
        "phpstan/phpstan-doctrine": "2.0.27",
        "phpstan/phpstan-phpunit": "2.0.18",
        "phpstan/phpstan-symfony": "2.0.20",
        "phpunit/phpunit": "9.6.35",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.0 || ^8.0",
        "symfony/test-pack": "1.1",
        "zol/test-openapi-server": "*"
    },
    "autoload": {
        "psr-4": {
            "Zol\\Apifony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zol\\Apifony\\Tests\\": "tests/",
            "Zol\\Apifony\\Tests\\TestOpenApiServer\\" : "tests/bundle/src"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "tests/bundle"
        }
    ],
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
